{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EduLinked-coder/learning-support-navigator/contracts/public-projection-intake.schema.json",
  "title": "Learning Support Navigator Public Projection Intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceRepository",
    "sourceRevision",
    "sourceType",
    "projectionVersion",
    "classification",
    "approvalEvidence",
    "preparedAt",
    "minimisationStatement",
    "payload"
  ],
  "properties": {
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 7
    },
    "sourceType": {
      "enum": [
        "paired_private_projection",
        "approved_public_source"
      ]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "projectionVersion": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "const": "public_approved"
    },
    "approvalEvidence": {
      "type": "string",
      "minLength": 1
    },
    "preparedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimisationStatement": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sourceType": {
            "const": "approved_public_source"
          }
        }
      },
      "then": {
        "required": [
          "sourcePath"
        ]
      }
    }
  ]
}
